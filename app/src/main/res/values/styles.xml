<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Card Style -->
    <style name="PercentCornerCard" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.PercentCorner</item>
    </style>

    <style name="ShapeAppearance.App.PercentCorner" parent="">
        <!-- 15% corner radius of the card's height/width (smallest dimension) -->
        <item name="cornerSize">15%</item>
    </style>

    <style name="PercentCornerGrid" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.PercentCornerGrid</item>
    </style>

    <style name="ShapeAppearance.App.PercentCornerGrid" parent="">
        <!-- 10% corner radius for the large grid container -->
        <item name="cornerSize">7%</item>
    </style>
</resources>
