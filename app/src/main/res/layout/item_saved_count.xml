<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="15dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke_color"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- Top Row: Title/Date + Count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Title & Date Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_title_placeholder"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_date_placeholder"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:drawablePadding="4dp"
                    app:drawableStartCompat="@drawable/ic_clock"
                    app:drawableTint="@color/hint_text"/>

            </LinearLayout>

            <!-- Count Column -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_count_placeholder"
                    android:textColor="@color/tasbeeh_blue_primary"
                    android:textSize="23sp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:drawablePadding="4dp"
                    app:drawableTint="@color/tasbeeh_blue_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_total"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>
            </LinearLayout>

        </LinearLayout>
        
        <!-- Action Buttons Row -->
        <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:layout_marginTop="20dp"
             android:gravity="center_vertical"
             android:baselineAligned="false">

             <Button
                 android:id="@+id/btnContinue"
                 android:layout_width="0dp"
                 android:layout_height="36dp"
                 android:layout_weight="1"
                 android:maxWidth="320dp"
                 android:text="@string/label_resume"
                 android:textAllCaps="true"
                 android:textColor="@color/white"
                 android:textSize="12sp"
                 android:textStyle="bold"
                 android:letterSpacing="0.05"
                 android:backgroundTint="@color/tasbeeh_blue_primary"
                 android:insetTop="0dp"
                 android:insetBottom="0dp"
                 android:layout_marginEnd="12dp"
                 app:icon="@drawable/ic_play_circle"
                 app:iconGravity="textStart"
                 app:iconPadding="8dp"
                 app:iconTint="@color/white"
                 app:cornerRadius="10dp"
                 style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

             <!-- Delete Button (Icon only style) -->
             <FrameLayout
                 android:id="@+id/btnDelete"
                 android:layout_width="40dp"
                 android:layout_height="40dp"
                 android:background="@drawable/item_bg_shape"
                 android:backgroundTint="@color/icon_btn_bg"
                 android:clickable="true"
                 android:focusable="true"
                 android:contentDescription="@string/cd_delete">
                 
                 <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_delete" 
                    app:tint="@color/delete_text"
                    android:contentDescription="@null" />
             </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
