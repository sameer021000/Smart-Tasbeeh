<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="@color/card_background"
    app:strokeColor="@color/card_stroke_color"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/tasbeeh_blue_primary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masha Allah!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tasbeeh_blue_primary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTargetMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You have reached your goal."
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnContinue"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:background="@drawable/selector_cancel_reset"
                android:stateListAnimator="@null"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnIncreaseTarget"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="New Target"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:backgroundTint="@color/tasbeeh_blue_primary"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
