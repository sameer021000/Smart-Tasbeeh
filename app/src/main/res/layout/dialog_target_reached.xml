<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_percent="0.90"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.SmartTasbeeh.ResponsiveCard"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Responsive Guidelines -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.08" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.92" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.10" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.90" />

            <ImageView
                android:id="@+id/ivSuccess"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_check_circle"
                android:contentDescription="@string/cd_success"
                app:tint="@color/tasbeeh_blue_primary"
                app:layout_constraintWidth_percent="0.25"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="@id/guideTop"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"/>

            <Space
                android:id="@+id/spaceBelow_ivSuccess"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,40:1"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"
                app:layout_constraintTop_toBottomOf="@id/ivSuccess" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/dialog_target_reached_title"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/tasbeeh_blue_primary"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/spaceBelow_ivSuccess"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"/>

            <Space
                android:id="@+id/spaceBelow_tvTitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,40:1"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <TextView
                android:id="@+id/tvTargetMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/dialog_target_reached_message"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/spaceBelow_tvTitle"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"/>

            <Space
                android:id="@+id/spaceMessageToButtons"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,15:1"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"
                app:layout_constraintTop_toBottomOf="@id/tvTargetMessage" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"
                app:layout_constraintTop_toBottomOf="@id/spaceMessageToButtons"
                app:layout_constraintBottom_toBottomOf="@id/guideBottom">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnContinue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="@string/dialog_continue"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/selector_cancel_reset"
                    android:stateListAnimator="@null"
                    android:minHeight="48dp"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="12sp"
                    app:layout_constraintHeight_min="48dp"
                    app:layout_constraintWidth_max="280dp"
                    app:layout_constraintDimensionRatio="H,2.5:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/buttonGap"
                    app:layout_constraintHorizontal_weight="1"/>

                <Space
                    android:id="@+id/buttonGap"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintHorizontal_weight="0.2"
                    app:layout_constraintStart_toEndOf="@id/btnContinue"
                    app:layout_constraintEnd_toStartOf="@+id/btnIncreaseTarget"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <Button
                    android:id="@+id/btnIncreaseTarget"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="@string/dialog_new_target"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/tasbeeh_blue_primary"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="48dp"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="12sp"
                    app:layout_constraintHeight_min="48dp"
                    app:layout_constraintWidth_max="280dp"
                    app:layout_constraintDimensionRatio="H,2.5:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/buttonGap"
                    app:layout_constraintHorizontal_weight="1"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
