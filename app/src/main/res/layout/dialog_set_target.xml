<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background_premium"
    android:padding="24dp"
    android:layout_gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Target"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter the target count you want to reach."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp"/>

    <!-- Simple Bordered Custom EditText -->
    <EditText
        android:id="@+id/etTarget"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_edittext_selector"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:hint="e.g. 100"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/hint_text"
        android:textCursorDrawable="@null"
        android:textSize="16sp"
        android:singleLine="true"
        android:inputType="number"
        android:maxLength="7"
        android:layout_marginBottom="24dp"/>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:background="@drawable/selector_cancel_save"
            android:stateListAnimator="@null"
            android:padding="0dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnStartTarget"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Set"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/tasbeeh_blue_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
    </LinearLayout>

</LinearLayout>
