<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".AnalysisActivity">

    <!-- Main Scroll View -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavDivider">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <!-- Dynamic Top Spacer (Height depends on width via ratio) -->
            <View
                android:id="@+id/topSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,20:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Header -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.6"
                app:layout_constraintDimensionRatio="H,5:1"
                android:text="@string/zikr_analysis_title"
                android:textColor="@color/tasbeeh_blue_primary"
                android:gravity="center"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="60sp"
                app:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-black"
                app:layout_constraintTop_toBottomOf="@id/topSpacer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <View
                android:id="@+id/spaceBelow_tvTitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,150:1"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.55"
                app:layout_constraintDimensionRatio="H,12:1"
                android:text="@string/zikr_analysis_subtitle"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeStepGranularity="1sp"
                app:layout_constraintTop_toBottomOf="@id/spaceBelow_tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <View
                android:id="@+id/spaceBelow_tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,15:1"
                app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Circular Button Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnTap"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintWidth_percent="0.5"
                app:layout_constraintTop_toBottomOf="@id/spaceBelow_tvSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Inner Circle (bg) - Scaled with percent instead of margin -->
                <View
                    android:id="@+id/innerCircle"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintWidth_percent="0.98"
                    app:layout_constraintHeight_percent="0.98"
                    android:background="@drawable/bg_circle_button"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Progress Bar (Thin Line Outer Ring) -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/circular_progress"
                    android:background="@null"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:max="100"
                    android:progress="0"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Count Text -->
                <TextView
                    android:id="@+id/tvCount"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintWidth_percent="0.5"
                    app:layout_constraintHeight_percent="0.5"
                    android:text="@string/Count_Number"
                    android:gravity="center"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="100sp"
                    app:autoSizeStepGranularity="1sp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold"
                    android:textColor="@color/tasbeeh_blue_primary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tvTapHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintWidth_percent="0.2"
                    android:text="@string/Tap_Button_Text"
                    android:gravity="center"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeStepGranularity="1sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintTop_toBottomOf="@id/tvCount"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Pause Overlay (Visible when Paused) -->
                <TextView
                    android:id="@+id/tvPausedOverlay"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintWidth_percent="0.6"
                    app:layout_constraintDimensionRatio="H,3:1"
                    android:text="@string/paused_text"
                    android:gravity="center"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="40sp"
                    app:autoSizeStepGranularity="1sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/delete_text"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Click overlay (This intercepts taps for counting) -->
                <View
                    android:id="@+id/tapActionView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintWidth_percent="0.9"
                    app:layout_constraintHeight_percent="0.9"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/action_tap_count"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Start Button Overlay (Must be LAST to be ON TOP of tap overlay) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartOverlay"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintWidth_percent="0.5"
                    app:layout_constraintDimensionRatio="H,2.1:1"
                    android:text="@string/start_button_text"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="30sp"
                    app:autoSizeStepGranularity="1sp"
                    android:visibility="visible"
                    android:elevation="10dp"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-black"                    android:letterSpacing="0.05"
                    android:backgroundTint="@color/tasbeeh_blue_primary"
                    app:layout_constraintVertical_bias="0.52"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/spaceBelow_btnTap"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,15:1"
                app:layout_constraintTop_toBottomOf="@+id/btnTap"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Controls Row (Pause Button) -->
            <LinearLayout
                android:id="@+id/controlsRow"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.28"
                app:layout_constraintDimensionRatio="H,2.0:1"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/spaceBelow_btnTap"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fabPause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/pause_button_text"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/white"
                    android:letterSpacing="0.05"
                    app:backgroundTint="@color/tasbeeh_blue_primary"
                    android:elevation="10dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:visibility="invisible"
                    android:contentDescription="@string/action_pause_analysis"/>

            </LinearLayout>

            <View
                android:id="@+id/spaceBelow_controlsRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,15:1"
                app:layout_constraintTop_toBottomOf="@+id/controlsRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Pause / Finish Options -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetAnalysis"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.28"
                app:layout_constraintDimensionRatio="H,2.0:1"
                android:text="@string/reset_button_text"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/white"
                android:letterSpacing="0.05"
                android:visibility="gone"
                android:backgroundTint="@color/tasbeeh_blue_primary"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_marginEnd="10dp"
                app:layout_constraintTop_toBottomOf="@+id/spaceBelow_controlsRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnShowReport"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowReport"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.28"
                app:layout_constraintDimensionRatio="H,2.0:1"
                android:text="@string/report_button_text"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/white"
                android:letterSpacing="0.05"
                android:visibility="gone"
                android:backgroundTint="@color/tasbeeh_blue_primary"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toBottomOf="@+id/spaceBelow_controlsRow"
                app:layout_constraintStart_toEndOf="@+id/btnResetAnalysis"
                app:layout_constraintEnd_toEndOf="parent"/>

            <View
                android:id="@+id/spaceBelow_btnShowReport"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,15:1"
                app:layout_constraintTop_toBottomOf="@+id/btnShowReport"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Report Container (Visible on request) -->
            <!-- Report Container (Visible on request) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/reportContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:animateLayoutChanges="true"
                app:layout_constraintTop_toBottomOf="@id/spaceBelow_btnShowReport"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Carousel -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAnalysisCards"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintWidth_percent="1.0"
                    app:layout_constraintDimensionRatio="H,1.05:1"
                    android:clipToPadding="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <View
                    android:id="@+id/spaceBelow_rvAnalysisCards"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="H,15:1"
                    app:layout_constraintTop_toBottomOf="@+id/rvAnalysisCards"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Dots Indicator -->
                <LinearLayout
                    android:id="@+id/layoutDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/spaceBelow_rvAnalysisCards"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Dynamic Bottom Spacer (Height relative to width via ratio) -->
            <View
                android:id="@+id/bottomSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,20:1"
                app:layout_constraintTop_toBottomOf="@id/reportContainer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


    <!-- Bottom Nav -->
    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"
        android:background="@color/count_text_color"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"/>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.10"
        android:background="@color/nav_bg"
        android:orientation="horizontal"
        android:weightSum="4"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Analysis (Active) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnNavAnalysis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:background="@color/nav_text_selected"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/imgAnalysis"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_analysis"
                app:tint="@color/nav_text_selected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtAnalysis"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.35"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_chainStyle="packed"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/txtAnalysis"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/nav_analysis"
                android:textColor="@color/nav_text_selected"
                android:gravity="center"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgAnalysis"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintWidth_percent="0.9"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeStepGranularity="1sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Counter -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnNavCounter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/imgCounter"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_add"
                app:tint="@color/nav_text_unselected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtCounter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.35"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_chainStyle="packed"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/txtCounter"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/nav_counter"
                android:textColor="@color/nav_text_unselected"
                android:gravity="center"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgCounter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintWidth_percent="0.9"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeStepGranularity="1sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- History -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnSavedCounts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/imgHistory"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/nav_text_unselected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtHistory"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.35"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_chainStyle="packed"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/txtHistory"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/nav_history"
                android:textColor="@color/nav_text_unselected"
                android:gravity="center"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgHistory"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintWidth_percent="0.9"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeStepGranularity="1sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Settings -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/imgSettings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/nav_text_unselected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtSettings"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.35"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_chainStyle="packed"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/txtSettings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/nav_settings"
                android:textColor="@color/nav_text_unselected"
                android:gravity="center"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgSettings"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintWidth_percent="0.9"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeStepGranularity="1sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
