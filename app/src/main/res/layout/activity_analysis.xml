<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".AnalysisActivity">
    
    <!-- Main Scroll View -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavDivider">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Header -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zikhr Analysis"
                android:textColor="@color/tasbeeh_blue_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to measure your Zikr speed"
                android:textColor="@color/hint_text"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Circular Button Container -->
            <FrameLayout
                android:id="@+id/btnTap"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Inner Circle (bg) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_circle_button" />

                <!-- Progress Bar (Thin Line Outer Ring) -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/circular_progress"
                    android:background="@null"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:max="100"
                    android:progress="0"
                    android:padding="2dp"/>
                    
                <!-- Count Text -->
                <TextView
                    android:id="@+id/tvCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="0"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:textColor="@color/tasbeeh_blue_primary"/>
                    
                <TextView
                     android:id="@+id/tvTapHint"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:layout_gravity="center"
                     android:text="TAP"
                     android:textSize="12sp"
                     android:textColor="@color/hint_text"
                     android:translationY="40dp"/>
                     
                <!-- Pause Overlay (Visible when Paused) -->
                 <TextView
                     android:id="@+id/tvPausedOverlay"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:layout_gravity="center"
                     android:text="PAUSED"
                     android:textSize="18sp"
                     android:textStyle="bold"
                     android:textColor="@color/tasbeeh_blue_accent"
                     android:background="#DDFFFFFF"
                     android:padding="8dp"
                     android:visibility="gone"/>

                <!-- Click overlay (This intercepts taps for counting) -->
                <View
                    android:id="@+id/tapActionView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless" 
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- Start Button Overlay (Must be LAST to be ON TOP of tap overlay) -->
                <Button
                    android:id="@+id/btnStartOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="START"
                    android:textSize="20sp"
                    android:layout_gravity="center"
                    android:visibility="visible"
                    android:elevation="10dp"/>
                    
            </FrameLayout>
            
            <!-- Controls Row (Pause Button) -->
            <LinearLayout
                android:id="@+id/controlsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/btnTap"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabPause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_pause"
                    app:backgroundTint="@color/tasbeeh_blue_primary"
                    app:tint="@android:color/white"
                    app:fabSize="normal"
                    android:visibility="invisible"/>

            </LinearLayout>
            
            <!-- Pause / Finish Options -->
            <LinearLayout
                 android:id="@+id/layoutPauseOptions"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:orientation="horizontal"
                 android:visibility="gone"
                 android:layout_marginTop="12dp"
                 app:layout_constraintTop_toBottomOf="@id/controlsRow"
                 app:layout_constraintStart_toStartOf="parent"
                 app:layout_constraintEnd_toEndOf="parent">
                 
                 <Button
                     android:id="@+id/btnResetAnalysis"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="Reset"
                     android:layout_marginEnd="16dp"/>

                 <Button
                     android:id="@+id/btnShowReport"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="Report"/>
            </LinearLayout>

            <!-- Report Container (Visible on request) -->
            <LinearLayout
                android:id="@+id/reportContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/layoutPauseOptions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                
                 <TextView
                    android:id="@+id/tvReportSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Summary Stats"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/tasbeeh_blue_primary"
                    android:paddingBottom="16dp"/>
                    
                <!-- Graph -->
                <FrameLayout
                    android:id="@+id/graphContainer"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@drawable/info_box_background"
                    android:elevation="2dp"
                    android:padding="8dp"
                    android:layout_marginBottom="24dp">
                </FrameLayout>
                
                <TextView
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="Detailed Log"
                     android:textStyle="bold"
                     android:textColor="@color/tasbeeh_blue_accent"
                     android:layout_marginBottom="8dp"/>

                <!-- Header Row -->
                 <LinearLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:orientation="horizontal"
                     android:background="#E0E0E0"
                     android:padding="8dp">
                     <TextView
                         android:layout_width="0dp"
                         android:layout_height="wrap_content"
                         android:layout_weight="1"
                         android:text="#"
                         android:textStyle="bold"
                         android:gravity="center"/>
                     <TextView
                         android:layout_width="0dp"
                         android:layout_height="wrap_content"
                         android:layout_weight="2"
                         android:text="Time (sec)"
                         android:textStyle="bold"
                         android:gravity="center"/>
                     <TextView
                         android:layout_width="0dp"
                         android:layout_height="wrap_content"
                         android:layout_weight="3"
                         android:text="Interval"
                         android:textStyle="bold"
                         android:gravity="center"/>
                 </LinearLayout>
                 
                 <!-- Table Body -->
                 <TableLayout
                     android:id="@+id/tableReport"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:stretchColumns="1,2">
                 </TableLayout>
                 
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


    <!-- Bottom Nav -->
    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"
        android:background="#ccc"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"/>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/nav_bg"
        android:orientation="horizontal"
        android:weightSum="4"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- History -->
        <LinearLayout
            android:id="@+id/btnNavHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/nav_text_unselected"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HISTORY"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_text_unselected"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Counter -->
        <LinearLayout
            android:id="@+id/btnNavCounter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_add"
                app:tint="@color/nav_text_unselected"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COUNTER"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_text_unselected"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/nav_text_unselected"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_text_unselected"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
        
        <!-- Analysis (Active) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_analysis"
                app:tint="@color/nav_text_selected"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANALYSIS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_text_selected"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
