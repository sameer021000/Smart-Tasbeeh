<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".MainActivity">

    <!-- Guideline for 2% Top Margin -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02" />

    <!-- Guideline for 8% Start Margin (Left) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideStartMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.08" />

    <!-- Guideline for 8% End Margin (Right) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideEndMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.92" />

    <!-- 1. Top Card with Count and Actions -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCountDisplay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        style="@style/PercentCornerCard"
        app:layout_constraintWidth_percent="0.88"
        app:layout_constraintHeight_percent="0.16"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/card_stroke_color"
        app:cardBackgroundColor="@color/card_background"
        app:layout_constraintTop_toTopOf="@id/topGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Guidelines for Approximation Padding (15% vertical ~ 3% horizontal) -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.1" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.9" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.15" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.85" />

            <!-- Count Number -->
            <TextView
                android:id="@+id/tvCountDisplay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:gravity="center_vertical|start"
                android:text="@string/Count_Number"
                android:textColor="@color/count_text_color"
                android:textSize="58sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintTop_toTopOf="@id/guideTop"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"
                app:layout_constraintBottom_toBottomOf="@id/guideBottom"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="100sp"
                app:autoSizeStepGranularity="2sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Invisible Space for 1.5% Margin -->
    <Space
        android:id="@+id/spaceBtnGap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardCountDisplay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.015" />

    <!-- Save Button (Left) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="0dp"
        style="@style/PercentCornerCard"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_percent="0.07"
        app:cardElevation="5dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/card_stroke_color"
        app:cardBackgroundColor="@color/tasbeeh_blue_accent"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="@id/guideStartMargin"
        app:layout_constraintTop_toBottomOf="@id/spaceBtnGap"
        android:contentDescription="@string/action_save_count">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_save"
                app:tint="@color/card_background"
                app:layout_constraintWidth_percent="0.777"
                app:layout_constraintHeight_percent="0.777"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="@null"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_height="0dp"
        android:layout_width="0dp"
        android:text="@string/Tasbeeh_Name"
        android:textColor="@color/tasbeeh_blue_primary"
        android:gravity="center"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.10"
        android:shadowColor="@color/card_stroke_color"
        android:shadowRadius="12"
        android:shadowDy="4"
        app:layout_constraintEnd_toStartOf="@+id/btnReset"
        app:layout_constraintStart_toEndOf="@+id/btnSave"
        app:layout_constraintTop_toTopOf="@+id/btnSave"
        app:layout_constraintBottom_toBottomOf="@+id/btnReset"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeMaxTextSize="40sp"
        app:autoSizeStepGranularity="1sp" />

    <!-- Reset Button (Right) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnReset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        style="@style/PercentCornerCard"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_percent="0.07"
        app:cardElevation="5dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/card_stroke_color"
        app:cardBackgroundColor="@color/tasbeeh_blue_accent"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="@id/guideEndMargin"
        app:layout_constraintTop_toBottomOf="@id/spaceBtnGap"
        android:contentDescription="@string/action_reset_count">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_refresh"
                app:tint="@color/card_background"
                app:layout_constraintWidth_percent="0.777"
                app:layout_constraintHeight_percent="0.777"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="@null"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Invisible Space for 1.5% Margin -->
    <Space
        android:id="@+id/spaceBtnGap2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnSave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.015" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bigBoxContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.88"
        app:layout_constraintHeight_percent="0.48"
        style="@style/PercentCornerGrid"
        app:cardBackgroundColor="@color/card_background"
        app:strokeWidth="2dp"
        app:strokeColor="@color/card_stroke_color"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/spaceBtnGap2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Grid Background -->
            <View
                android:id="@+id/gridBackground"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="invisible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- "TAP" Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/videoButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                style="@style/PercentCornerCard"
                app:layout_constraintWidth_percent="0.34"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/tasbeeh_blue_accent">

                <!-- Inner border effect could be added here if needed, keeping simple matching design -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/Tap_Button_Text"
                    android:textColor="@color/tap_btn_text"
                    android:gravity="center"
                    android:padding="4dp"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeStepGranularity="1sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <!-- Simple ripple overlay for touch feedback if needed -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="false"
                    android:focusable="false"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- Helper Text -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.8"
                android:layout_marginBottom="32dp"
                android:text="@string/Button_Reposition_Hint_Text"
                android:textColor="@color/hint_text"
                android:gravity="center"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="6sp"
                app:autoSizeMaxTextSize="11sp"
                app:autoSizeStepGranularity="1sp"
                android:maxLines="1"
                android:letterSpacing="0.05"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Invisible Space for 2% Margin -->
    <Space
        android:id="@+id/spaceBtnGap3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/bigBoxContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.015" />

        <!-- Decrease Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnDecrease"
            android:layout_width="0dp"
            android:layout_height="0dp"
            style="@style/PercentCornerCard"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.07"
            app:cardElevation="5dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/card_stroke_color"
            app:cardBackgroundColor="@color/tasbeeh_blue_accent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/action_decrease_count"
            app:layout_constraintEnd_toStartOf="@+id/btnAuto"
            app:layout_constraintStart_toEndOf="@+id/btnSave"
            app:layout_constraintTop_toTopOf="@+id/btnAuto"
            app:layout_constraintBottom_toBottomOf="@+id/btnAuto">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/card_background"
                    app:layout_constraintWidth_percent="0.777"
                    app:layout_constraintHeight_percent="0.777"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:contentDescription="@null"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Auto Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAuto"
            android:layout_width="0dp"
            android:layout_height="0dp"
            style="@style/PercentCornerCard"
            app:layout_constraintHeight_percent="0.09"
            app:layout_constraintDimensionRatio="1:1"
            app:cardElevation="5dp"
            app:cardBackgroundColor="@color/tasbeeh_blue_accent"
            app:strokeWidth="2dp"
            app:strokeColor="@color/card_stroke_color"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/action_auto_count"
            app:layout_constraintTop_toBottomOf="@+id/spaceBtnGap3"
            app:layout_constraintStart_toStartOf="@+id/cardCountDisplay"
            app:layout_constraintEnd_toEndOf="@+id/cardCountDisplay">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/ivAutoIcon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_auto"
                    app:tint="@color/card_background"
                    app:layout_constraintWidth_percent="0.666"
                    app:layout_constraintHeight_percent="0.666"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:contentDescription="@null"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Target Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnTarget"
            android:layout_width="0dp"
            android:layout_height="0dp"
            style="@style/PercentCornerCard"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.07"
            app:cardElevation="5dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/card_stroke_color"
            app:cardBackgroundColor="@color/tasbeeh_blue_accent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/action_set_target"
            app:layout_constraintStart_toEndOf="@+id/btnAuto"
            app:layout_constraintEnd_toStartOf="@+id/btnReset"
            app:layout_constraintTop_toTopOf="@+id/btnAuto"
            app:layout_constraintBottom_toBottomOf="@+id/btnAuto">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_target"
                    app:tint="@color/card_background"
                    app:layout_constraintWidth_percent="0.777"
                    app:layout_constraintHeight_percent="0.777"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:contentDescription="@null"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    <!-- Invisible Space for 1.5% Margin -->
    <Space
        android:id="@+id/spaceBtnGap4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnAuto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.015" />

    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"
        android:background="@color/count_text_color"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"/>

    <!-- 3. Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/nav_bg"
        android:orientation="horizontal"
        android:weightSum="4"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spaceBtnGap4">

        <!-- Analysis -->
        <LinearLayout
            android:id="@+id/btnAnalysis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_analysis"
                app:tint="@color/nav_text_unselected"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_analysis"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:textColor="@color/nav_text_unselected"/>
        </LinearLayout>

        <!-- Counter (Active) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_add"
                app:tint="@color/nav_text_selected" android:contentDescription="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_counter"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:textColor="@color/nav_text_selected"/>
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:id="@+id/btnSavedCounts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/nav_text_unselected" android:contentDescription="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_history"
                android:textColor="@color/nav_text_unselected"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/nav_text_unselected" android:contentDescription="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_settings"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:textColor="@color/nav_text_unselected"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>