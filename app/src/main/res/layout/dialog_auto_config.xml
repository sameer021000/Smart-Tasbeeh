<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_percent="0.90"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.SmartTasbeeh.ResponsiveCard"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeColor="@color/card_stroke_color"
        app:strokeWidth="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Responsive Guidelines -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.08" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.92" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.10" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.90" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/dialog_auto_title"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="@id/guideTop"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"/>
            <Space
                android:id="@+id/spaceTitleToValue"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,40:1"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <TextView
                android:id="@+id/tvSpeedValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/dialog_auto_speed_format"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/spaceTitleToValue"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"/>

            <Space
                android:id="@+id/spaceValueToSlider"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,40:1"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"
                app:layout_constraintTop_toBottomOf="@id/tvSpeedValue" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:valueFrom="0.3"
                android:valueTo="5.0"
                android:stepSize="0.1"
                android:value="1.0"
                app:thumbColor="@color/tasbeeh_blue_primary"
                app:trackColorActive="@color/tasbeeh_blue_primary"
                app:trackColorInactive="@color/card_stroke_color"
                app:layout_constraintTop_toBottomOf="@id/spaceValueToSlider"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"/>
            <Space
                android:id="@+id/spaceBelow_sliderSpeed"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,40:1"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"
                app:layout_constraintTop_toBottomOf="@id/sliderSpeed" />

            <TextView
                android:id="@+id/tvMoreTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_more_time"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|end"
                app:layout_constraintTop_toBottomOf="@id/spaceBelow_sliderSpeed"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"/>

            <Space
                android:id="@+id/spaceMoreTimeToButtons"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,15:1"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"
                app:layout_constraintTop_toBottomOf="@id/tvMoreTime" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/spaceMoreTimeToButtons"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"
                app:layout_constraintBottom_toBottomOf="@id/guideBottom">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCancelAuto"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="@string/dialog_cancel"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/selector_cancel_save"
                    android:stateListAnimator="@null"
                    android:minHeight="48dp"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:layout_constraintHeight_min="48dp"
                    app:layout_constraintWidth_max="280dp"
                    app:layout_constraintDimensionRatio="H,2.5:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/buttonGap"
                    app:layout_constraintHorizontal_weight="1"/>

                <Space
                    android:id="@+id/buttonGap"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintHorizontal_weight="0.2"
                    app:layout_constraintStart_toEndOf="@id/btnCancelAuto"
                    app:layout_constraintEnd_toStartOf="@+id/btnStartAuto"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <Button
                    android:id="@+id/btnStartAuto"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="@string/dialog_auto_start"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-black"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:backgroundTint="@color/tasbeeh_blue_primary"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="48dp"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:layout_constraintHeight_min="48dp"
                    app:layout_constraintWidth_max="280dp"
                    app:layout_constraintDimensionRatio="H,2.5:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/buttonGap"
                    app:layout_constraintHorizontal_weight="1"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
