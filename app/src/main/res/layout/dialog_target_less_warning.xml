<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background_premium"
    android:padding="24dp"
    android:layout_gravity="center">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Existing Count"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entered Target is less than or equal to current count. Do you want to start from 0?"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:background="@drawable/selector_cancel_reset"
            android:stateListAnimator="@null"
            android:padding="0dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnStartFromZero"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Start from 0"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/delete_text"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</LinearLayout>
