<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_vertical_50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideTopMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02" />

    <!-- 1. Left Side: Count Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCountDisplay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        style="@style/PercentCornerCard"
        app:layout_constraintWidth_percent="0.44"
        app:layout_constraintHeight_percent="0.26"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/card_stroke_color"
        app:cardBackgroundColor="@color/card_background"
        app:layout_constraintTop_toBottomOf="@id/guideTopMargin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_vertical_50">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Guidelines for Approximation Padding -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.07" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.93" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.05" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.95" />

            <!-- Count Number -->
            <TextView
                android:id="@+id/tvCountDisplay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:gravity="center_vertical|start"
                android:text="@string/Count_Number"
                android:textColor="@color/count_text_color"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                app:layout_constraintStart_toStartOf="@id/guideStart"
                app:layout_constraintTop_toTopOf="@id/guideTop"
                app:layout_constraintEnd_toEndOf="@id/guideEnd"
                app:layout_constraintBottom_toBottomOf="@id/guideBottom"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="170sp"
                app:autoSizeStepGranularity="5sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Invisible Space for 2% Margin -->
    <Space
        android:id="@+id/spaceLeftGap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.02"
        app:layout_constraintTop_toBottomOf="@id/cardCountDisplay"
        app:layout_constraintStart_toStartOf="@id/guideline_vertical_50"
        app:layout_constraintEnd_toStartOf="parent"/>

        <!-- Row 1: Save & Reset -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="0dp"
            style="@style/PercentCornerCard"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.14"
            app:cardElevation="5dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/card_stroke_color"
            app:cardBackgroundColor="@color/tasbeeh_blue_accent"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/spaceLeftGap"
            app:layout_constraintStart_toStartOf="@id/cardCountDisplay"
            android:contentDescription="@string/action_save_count">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_save"
                    app:tint="@color/card_background"
                    app:layout_constraintWidth_percent="0.66"
                    app:layout_constraintHeight_percent="0.66"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:contentDescription="@null"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="0dp"
            style="@style/PercentCornerCard"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.14"
            app:cardElevation="5dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/card_stroke_color"
            app:cardBackgroundColor="@color/tasbeeh_blue_accent"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/spaceLeftGap"
            app:layout_constraintEnd_toEndOf="@id/cardCountDisplay"
            android:contentDescription="@string/action_reset_count">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/card_background"
                    app:layout_constraintWidth_percent="0.66"
                    app:layout_constraintHeight_percent="0.66"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:contentDescription="@null"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Row 2: Auto -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAuto"
            android:layout_width="0dp"
            android:layout_height="0dp"
            style="@style/PercentCornerCard"
            app:layout_constraintHeight_percent="0.2"
            app:layout_constraintDimensionRatio="1:1"
            app:cardElevation="5dp"
            app:cardBackgroundColor="@color/tasbeeh_blue_accent"
            app:strokeWidth="2dp"
            app:strokeColor="@color/card_stroke_color"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/btnSave"
            app:layout_constraintStart_toEndOf="@id/btnSave"
            app:layout_constraintEnd_toStartOf="@id/btnReset"
            android:contentDescription="@string/action_auto_count">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivAutoIcon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_auto"
                    app:tint="@color/card_background"
                    app:layout_constraintWidth_percent="0.666"
                    app:layout_constraintHeight_percent="0.666"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:contentDescription="@null"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Row 3: Decrease & Target -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnDecrease"
            android:layout_width="0dp"
            android:layout_height="0dp"
            style="@style/PercentCornerCard"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.14"
            app:cardElevation="5dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/card_stroke_color"
            app:cardBackgroundColor="@color/tasbeeh_blue_accent"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/btnAuto"
            app:layout_constraintStart_toStartOf="@id/cardCountDisplay"
            android:contentDescription="@string/action_decrease_count">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/card_background"
                    app:layout_constraintWidth_percent="0.66"
                    app:layout_constraintHeight_percent="0.66"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:contentDescription="@null"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnTarget"
            android:layout_width="0dp"
            android:layout_height="0dp"
            style="@style/PercentCornerCard"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.14"
            app:cardElevation="5dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/card_stroke_color"
            app:cardBackgroundColor="@color/tasbeeh_blue_accent"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/btnAuto"
            app:layout_constraintEnd_toEndOf="@id/btnReset"
            android:contentDescription="@string/action_set_target">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_target"
                    app:tint="@color/card_background"
                    app:layout_constraintWidth_percent="0.66"
                    app:layout_constraintHeight_percent="0.66"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:contentDescription="@null"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    <!-- Invisible Space below controls -->
    <Space
        android:id="@+id/spaceBelowControls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.02"
        app:layout_constraintTop_toBottomOf="@id/btnTarget"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_vertical_50"/>

    <!-- 2. Right Side: Big Box Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bigBoxContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        style="@style/PercentCornerGrid"
        app:cardBackgroundColor="@color/card_background"
        app:strokeWidth="2dp"
        app:strokeColor="@color/card_stroke_color"
        app:cardElevation="0dp"
        app:layout_constraintWidth_percent="0.44"
        app:layout_constraintStart_toEndOf="@id/guideline_vertical_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideTopMargin"
        app:layout_constraintBottom_toTopOf="@id/spaceBelowBigBox">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Grid Background -->
            <View
                android:id="@+id/gridBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible"/>

            <!-- App Title (Inside Container, Top) -->
            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_height="0dp"
                android:layout_width="0dp"
                android:text="@string/Tasbeeh_Name"
                android:textColor="@color/tasbeeh_blue_primary"
                android:gravity="center"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.10"
                android:shadowColor="@color/card_stroke_color"
                android:shadowRadius="12"
                android:shadowDy="4"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.2"
                app:layout_constraintWidth_percent="0.8"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="120sp"
                app:autoSizeStepGranularity="1sp" />

            <!-- "TAP" Button -->
            <!-- 1/3 of container height = 0.33 percent -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/videoButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                style="@style/PercentCornerCard"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent="0.33"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/tasbeeh_blue_accent">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/Tap_Button_Text"
                    android:textColor="@color/tap_btn_text"
                    android:gravity="center"
                    android:padding="8dp"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeStepGranularity="1sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="false"
                    android:focusable="false"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- Helper Text -->
            <TextView
                android:id="@+id/helperText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.8"
                android:layout_marginBottom="32dp"
                android:text="@string/Button_Reposition_Hint_Text"
                android:textColor="@color/hint_text"
                android:gravity="center"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="6sp"
                app:autoSizeMaxTextSize="15sp"
                app:autoSizeStepGranularity="1sp"
                android:maxLines="1"
                android:letterSpacing="0.05"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Invisible Space below Big Box -->
    <Space
        android:id="@+id/spaceBelowBigBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.02"
        app:layout_constraintBottom_toTopOf="@id/bottomNavDivider"
        app:layout_constraintStart_toEndOf="@id/guideline_vertical_50"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/count_text_color"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/spaceBelowControls"/>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.21"
        android:background="@color/nav_bg"
        android:orientation="horizontal"
        android:weightSum="4"
        android:baselineAligned="false"
        android:divider="@drawable/nav_divider"
        android:showDividers="middle|beginning|end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bottomNavDivider">

        <!-- Analysis -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnAnalysis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/imgAnalysis"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_analysis"
                app:tint="@color/nav_text_unselected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtAnalysis"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.4"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_chainStyle="packed"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/txtAnalysis"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/nav_analysis"
                android:textColor="@color/nav_text_unselected"
                android:gravity="center"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgAnalysis"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintWidth_percent="0.9"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="30sp"
                app:autoSizeStepGranularity="1sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Counter (Active) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgCounter"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_add"
                app:tint="@color/nav_text_selected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtCounter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.4"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_chainStyle="packed"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/txtCounter"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/nav_counter"
                android:textColor="@color/nav_text_selected"
                android:gravity="center"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgCounter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintWidth_percent="0.9"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="30sp"
                app:autoSizeStepGranularity="1sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- History -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnSavedCounts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/imgHistory"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/nav_text_unselected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtHistory"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.4"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_chainStyle="packed"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/txtHistory"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/nav_history"
                android:textColor="@color/nav_text_unselected"
                android:gravity="center"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgHistory"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintWidth_percent="0.9"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="30sp"
                app:autoSizeStepGranularity="1sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Settings -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/imgSettings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/nav_text_unselected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtSettings"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.4"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_chainStyle="packed"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/txtSettings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/nav_settings"
                android:textColor="@color/nav_text_unselected"
                android:gravity="center"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgSettings"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintWidth_percent="0.9"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="30sp"
                app:autoSizeStepGranularity="1sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
