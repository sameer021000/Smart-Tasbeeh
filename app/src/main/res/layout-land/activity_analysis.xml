<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".AnalysisActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/leftContentBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.55" />

    <!-- LEFT SIDE CONTAINER (Centered Vertically) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/leftContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/leftContentBarrier">

        <!-- Circular Button Container -->
        <FrameLayout
            android:id="@+id/btnTap"
            android:layout_width="185dp"
            android:layout_height="185dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Inner Circle (bg) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:background="@drawable/bg_circle_button" />

            <!-- Progress Bar (Thin Line Outer Ring) -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:progressDrawable="@drawable/circular_progress"
                android:background="@null"
                style="?android:attr/progressBarStyleHorizontal"
                android:max="100"
                android:progress="0"
                android:padding="2dp"/>
            
            <!-- Count Text -->
            <TextView
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/Count_Number"
                android:textSize="50sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:textColor="@color/tasbeeh_blue_primary"/>
            
            <TextView
                android:id="@+id/tvTapHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/Tap_Button_Text"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_secondary"
                android:translationY="35dp"/>
             
            <!-- Pause Overlay -->
            <TextView
                android:id="@+id/tvPausedOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/paused_text"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/delete_text"
                android:visibility="gone"/>

            <!-- Click overlay -->
            <View
                android:id="@+id/tapActionView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:background="?attr/selectableItemBackgroundBorderless" 
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/action_tap_count"/>

            <!-- Start Button Overlay -->
            <Button
                android:id="@+id/btnStartOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_button_text"
                android:textSize="15sp"
                android:layout_gravity="center"
                android:visibility="visible"
                android:elevation="10dp"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:backgroundTint="@color/tasbeeh_blue_primary"
                app:cornerRadius="8dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
            
        </FrameLayout>

        <!-- Controls Region (Pause Button) -->
        <!-- We use an ID here to anchor controls below -->
        <View
            android:id="@+id/controlsAnchor"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/btnTap"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Pause Button (Centered below tap) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pause"
            app:backgroundTint="@color/tasbeeh_blue_primary"
            app:tint="@android:color/white"
            app:fabSize="mini"
            app:cardCornerRadius="7dp"
            app:cardElevation="5dp"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="@id/controlsAnchor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="@string/action_pause_analysis"/>

        <!-- Reset Button (Left of Pause) -->
        <Button
            android:id="@+id/btnResetAnalysis"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/reset_button_text"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:visibility="gone"
            android:backgroundTint="@color/tasbeeh_blue_primary"
            app:cornerRadius="8dp"
            android:layout_marginEnd="16dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            app:layout_constraintEnd_toStartOf="@+id/fabPause"
            app:layout_constraintTop_toTopOf="@id/controlsAnchor"
            app:layout_constraintBottom_toBottomOf="@id/fabPause"/>

        <!-- Report Button (Right of Pause) -->
        <Button
            android:id="@+id/btnShowReport"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/report_button_text"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:visibility="gone"
            android:backgroundTint="@color/tasbeeh_blue_primary"
            app:cornerRadius="8dp"
            android:layout_marginStart="16dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            app:layout_constraintStart_toEndOf="@+id/fabPause"
            app:layout_constraintTop_toTopOf="@id/controlsAnchor"
            app:layout_constraintBottom_toBottomOf="@id/fabPause"/>

        <!-- Used for layoutPauseOptions reference in Java if needed, though we removed it. 
             If Java still references it, we might need a dummy view or updated Java.
             But user replaced Java code to remove layoutPauseOptions usage in previous steps. -->
             
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RIGHT SIDE CONTAINER (Centered Vertically) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rightContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavDivider"
        app:layout_constraintStart_toEndOf="@id/leftContentBarrier"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zikr_analysis_title"
                android:textColor="@color/tasbeeh_blue_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zikr_analysis_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reportContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAnalysisCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:clipToPadding="false"/>

            <LinearLayout
                android:id="@+id/layoutDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="1dp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Divider -->
    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/count_text_color"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"/>

    <!-- Bottom Nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.19"
        android:background="@color/nav_bg"
        android:orientation="horizontal"
        android:weightSum="4"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Analysis (Active) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnNavAnalysis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:background="@color/nav_text_selected"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/imgAnalysis"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_analysis"
                app:tint="@color/nav_text_selected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtAnalysis"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.4"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_chainStyle="packed"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/txtAnalysis"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/nav_analysis"
                android:textColor="@color/nav_text_selected"
                android:gravity="center"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgAnalysis"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintWidth_percent="0.9"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="30sp"
                app:autoSizeStepGranularity="1sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Counter -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnNavCounter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/imgCounter"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_add"
                app:tint="@color/nav_text_unselected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtCounter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.4"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_chainStyle="packed"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/txtCounter"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/nav_counter"
                android:textColor="@color/nav_text_unselected"
                android:gravity="center"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgCounter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintWidth_percent="0.9"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="30sp"
                app:autoSizeStepGranularity="1sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- History -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnSavedCounts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/imgHistory"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/nav_text_unselected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtHistory"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.4"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_chainStyle="packed"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/txtHistory"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/nav_history"
                android:textColor="@color/nav_text_unselected"
                android:gravity="center"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgHistory"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintWidth_percent="0.9"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="30sp"
                app:autoSizeStepGranularity="1sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Settings -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/imgSettings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/nav_text_unselected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtSettings"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.4"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintVertical_chainStyle="packed"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/txtSettings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/nav_settings"
                android:textColor="@color/nav_text_unselected"
                android:gravity="center"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgSettings"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintWidth_percent="0.9"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="30sp"
                app:autoSizeStepGranularity="1sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>