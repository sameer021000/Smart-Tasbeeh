<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".AnalysisActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/leftContentBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.55" />

    <!-- Title and Subtitle - Right Side Top -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/leftContentBarrier"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zikr Analysis"
            android:textColor="@color/tasbeeh_blue_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to measure your Zikr speed"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Report Container (Below Title/Subtitle on Right) -->
    <LinearLayout
        android:id="@+id/reportContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="5dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNavDivider"
        app:layout_constraintStart_toEndOf="@id/leftContentBarrier"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAnalysisCards"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"/>

        <LinearLayout
            android:id="@+id/layoutDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="1dp"/>

    </LinearLayout>

    <!-- LEFT SIDE CONTENT -->

    <!-- Circular Button Container (Top Left, Centered Horizontally in Left Half) -->
    <FrameLayout
        android:id="@+id/btnTap"
        android:layout_width="185dp"
        android:layout_height="185dp"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/leftContentBarrier">

        <!-- Inner Circle (bg) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:background="@drawable/bg_circle_button" />

        <!-- Progress Bar (Thin Line Outer Ring) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:progressDrawable="@drawable/circular_progress"
            android:background="@null"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="0"
            android:padding="2dp"/>
            
        <!-- Count Text -->
        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="0"
            android:textSize="50sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:textColor="@color/tasbeeh_blue_primary"/>
            
        <TextView
             android:id="@+id/tvTapHint"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_gravity="center"
             android:text="TAP"
             android:textSize="10sp"
            android:fontFamily="sans-serif-black"
             android:textColor="@color/text_secondary"
             android:translationY="35dp"/>
             
        <!-- Pause Overlay (Visible when Paused) -->
         <TextView
             android:id="@+id/tvPausedOverlay"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_gravity="center"
             android:text="PAUSED"
             android:textSize="20sp"
             android:fontFamily="sans-serif-black"
             android:textColor="@color/delete_text"
             android:visibility="gone"/>

        <!-- Click overlay -->
        <View
            android:id="@+id/tapActionView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:background="?attr/selectableItemBackgroundBorderless" 
            android:clickable="true"
            android:focusable="true"/>

        <!-- Start Button Overlay -->
        <Button
            android:id="@+id/btnStartOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="START"
            android:textSize="15sp"
            android:layout_gravity="center"
            android:visibility="visible"
            android:elevation="10dp"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:backgroundTint="@color/tasbeeh_blue_primary"
            app:cornerRadius="8dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
            
    </FrameLayout>
    
    <!-- Controls Layout Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnTap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/leftContentBarrier">

        <!-- Pause Button (Persistent, Centered) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pause"
            app:backgroundTint="@color/tasbeeh_blue_primary"
            app:tint="@android:color/white"
            app:fabSize="mini"
            app:cardCornerRadius="7dp"
            app:cardElevation="5dp"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/btnResetAnalysis"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Reset"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:visibility="gone"
        android:backgroundTint="@color/tasbeeh_blue_primary"
        app:cornerRadius="5dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="5dp"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        app:layout_constraintTop_toBottomOf="@+id/btnTap"
        app:layout_constraintEnd_toStartOf="@+id/controlsLayout"/>

    <Button
        android:id="@+id/btnShowReport"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Report"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:visibility="gone"
        android:backgroundTint="@color/tasbeeh_blue_primary"
        app:cornerRadius="5dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="5dp"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        app:layout_constraintTop_toBottomOf="@+id/btnTap"
        app:layout_constraintStart_toEndOf="@+id/controlsLayout"/>

    <!-- Divider -->
    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/count_text_color"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"/>

    <!-- Bottom Nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/nav_bg"
        android:orientation="horizontal"
        android:weightSum="4"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Analysis (Active) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_analysis"
                app:tint="@color/nav_text_selected"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANALYSIS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_text_selected"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Counter -->
        <LinearLayout
            android:id="@+id/btnNavCounter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_add"
                app:tint="@color/nav_text_unselected"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COUNTER"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_text_unselected"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- History -->
        <LinearLayout
            android:id="@+id/btnSavedCounts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/nav_text_unselected"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HISTORY"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_text_unselected"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/nav_text_unselected"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_text_unselected"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>